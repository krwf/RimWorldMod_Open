<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <JobDef>
    <defName>RimKata_Pushed</defName>
    <driverClass>KRWF.RimKata.JobDriver_RimKataPushed</driverClass>
    <reportString>being pushed back.</reportString>
    <playerInterruptible>false</playerInterruptible>
    <forceCompleteBeforeNextJob>true</forceCompleteBeforeNextJob>
    <suspendable>false</suspendable>
    <checkOverrideOnDamage>Never</checkOverrideOnDamage>
    <casualInterruptible>false</casualInterruptible>
    <allowOpportunisticPrefix>false</allowOpportunisticPrefix>
    <carryThingAfterJob>true</carryThingAfterJob>
    <dropThingBeforeJob>false</dropThingBeforeJob>
  </JobDef>
  <JobDef>
    <defName>RimKata_Breach</defName>
    <allowOpportunisticPrefix>false</allowOpportunisticPrefix>
    <driverClass>KRWF.RimKata.JobDriver_RimKataBreach</driverClass>
    <reportString>breaching a door.</reportString>
    <alwaysShowWeapon>true</alwaysShowWeapon>
    <casualInterruptible>false</casualInterruptible>
    <collideWithPawns>true</collideWithPawns>
  </JobDef>
  <JobDef>
    <defName>RimKata_Attack</defName>
    <driverClass>KRWF.RimKata.JobDriver_RimKataAttack</driverClass>
    <alwaysShowWeapon>true</alwaysShowWeapon>
    <casualInterruptible>false</casualInterruptible>
    <collideWithPawns>true</collideWithPawns>
    <tryStartFlying>true</tryStartFlying>
    <overrideFlyChance>1</overrideFlyChance>
  </JobDef>
  
  <JobDef>
    <defName>RimKata_EquipSecondary</defName>
    <driverClass>KRWF.RimKata.JobDriver_RimKataEquipSecondary</driverClass>
    <reportString>equipping TargetA as a RimKata secondary weapon.</reportString>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>
</Defs>
